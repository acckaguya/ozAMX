+template<bool Late64,std::size_t Batch>
+inline void accumulate64_batch(double* block,const float* const (&micros)[Batch],std::size_t count,std::size_t stride,int& bad){
+    static_assert(Batch>=2);
+    for(std::size_t i=0;i<TM;++i)for(std::size_t j=0;j<TN;j+=16){
+        __m512d lo=_mm512_load_pd(block+i*stride+j),hi=_mm512_load_pd(block+i*stride+j+8);
+        for(std::size_t q=0;q<count;++q){
+            const auto f=_mm512_load_ps(micros[q]+i*TN+j);if constexpr(!Late64)bad|=nonfinite(f);
+            const auto fl=_mm512_cvtps_pd(_mm512_castps512_ps256(f)),fh=_mm512_cvtps_pd(_mm512_extractf32x8_ps(f,1));
+            lo=_mm512_add_pd(lo,fl);hi=_mm512_add_pd(hi,fh);
+            if constexpr(!Late64)bad|=nonfinite(lo)|nonfinite(hi);
+        }
+        _mm512_store_pd(block+i*stride+j,lo);_mm512_store_pd(block+i*stride+j+8,hi);
+    }
+}
+template<bool Late64,std::size_t Batch>
+inline void run_fp64_batch(double* block,std::size_t stride,const Packed64& p,std::size_t mb,std::size_t nb,std::size_t kb,std::size_t mi,std::size_t nj,unsigned steps,int depth,int& bad){
+    if constexpr(Batch==1){
+        alignas(64) float micro[TM*TN];
+        for(int diagonal=0;diagonal<depth;++diagonal)for(int ai=0;ai<=diagonal;++ai){
+            run_fp64_product<6>(p,ai,diagonal-ai,mb,nb,kb,mi,nj,micro,steps);
+            accumulate64<Late64>(block,micro,stride,bad);
+        }
+    }else{
+        // Product order remains diagonal-major, then ai-major. Flush a short tail
+        // without changing the sequence of float-to-double additions.
+        constexpr std::size_t MaxBatch=Batch;
+        alignas(64) float scratch[MaxBatch][TM*TN];
+        std::size_t count=0;
+        for(int diagonal=0;diagonal<depth;++diagonal)for(int ai=0;ai<=diagonal;++ai){
+            run_fp64_product<6>(p,ai,diagonal-ai,mb,nb,kb,mi,nj,scratch[count],steps);
+            if(++count==Batch){const float* micros[MaxBatch];for(std::size_t q=0;q<count;++q)micros[q]=scratch[q];accumulate64_batch<Late64,MaxBatch>(block,micros,count,stride,bad);count=0;}
+        }
+        if(count){
+            if(count==1)accumulate64<Late64>(block,scratch[0],stride,bad);
+            else {const float* micros[MaxBatch];for(std::size_t q=0;q<count;++q)micros[q]=scratch[q];accumulate64_batch<Late64,MaxBatch>(block,micros,count,stride,bad);}
+        }
+    }
+}
