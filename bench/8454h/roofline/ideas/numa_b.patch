--- /dev/null
+++ b/tests/numa_replication_probe.cpp
@@ -0,0 +1,25 @@
+#include "ozamx/gemm.hpp"
+
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <vector>
+
+static std::uint64_t bits(double x) { std::uint64_t u; std::memcpy(&u,&x,sizeof(u)); return u; }
+
+int main() {
+    constexpr std::size_t n=4096;
+    // A and B deliberately alias the leading part of C. The implementation
+    // must finish all reads and private reconstruction before committing C.
+    std::vector<double> c(n*n);
+    for(std::size_t i=0;i<c.size();++i) c[i]=double(int((i*17+31)%997)-498)/997.0;
+    const auto t=ozamx::gemm_fp64_profiled(n,n,1,c.data(),1,c.data(),n,c.data(),n,ozamx::ProductBudget::p6);
+    std::uint64_t h1=1469598103934665603ULL,h2=0x9e3779b97f4a7c15ULL;
+    for(double x:c) { const auto v=bits(x); h1=(h1^v)*1099511628211ULL; h2^=v+0x9e3779b97f4a7c15ULL+(h2<<6)+(h2>>2); }
+    std::cout<<"{\"digest\":\""<<std::hex<<h1<<":"<<h2<<std::dec
+             <<"\",\"replicate_b_seconds\":"<<t.replicate_b_seconds
+             <<",\"pack_seconds\":"<<t.pack_seconds
+             <<",\"node0_workers\":"<<t.replicate_node0_workers
+             <<",\"node1_workers\":"<<t.replicate_node1_workers
+             <<",\"fallback_workers\":"<<t.replicate_fallback_workers<<"}\n";
+}

